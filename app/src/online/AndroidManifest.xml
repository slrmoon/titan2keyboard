<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the "online" build only. The "offline" build has no network or install permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the settings screen uses the network: to check GitHub for a newer version and download it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
