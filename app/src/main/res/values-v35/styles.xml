<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 15+ draws apps that target SDK 35 edge to edge, under the status bar and title bar.
      The settings screens are plain scrolling forms, so keep the classic layout instead: content
      starts below the title bar and nothing scrolls underneath it.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
